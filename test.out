.data
.nl: .asciiz "\n"
.true_str: .asciiz "true"
.false_str: .asciiz "false"

.text
.global main

# Init sp
	addiu $sp, $sp, -4
	jal   main
	li    $v0, 10
	syscall

.data
_bool: .word 0
.data
_erg: .word 0
.data
_staticString: .word 0
.data
_addi: .word 0
.text
_recursive: 
		# Method Prologue
	sw $ra, 0($sp)		#PUSH
	subu  $sp, $sp, 4
	sw $fp, 0($sp)		#PUSH
	subu  $sp, $sp, 4
	addu  $fp, $sp, 8
	lw    $a0, _x
	sw $a0, 0($sp)		#PUSH
	subu  $sp, $sp, 4
	li    $a0, 1024
	sw $a0, 0($sp)		#PUSH
	subu  $sp, $sp, 4
	lw $t1, 0($sp)		#POP
	addu  $sp, $sp, 4
	lw $t0, 0($sp)		#POP
	addu  $sp, $sp, 4
	ble   $t0, $t1, ._L0
	li    $t0, 0
	sw $t0, 0($sp)		#PUSH
	subu  $sp, $sp, 4
	j     ._L0
._L0: 	# true case
	li    $t0, -1
	sw $t0, 0($sp)		#PUSH
	subu  $sp, $sp, 4
._L0: 
	lw $a0, 0($sp)		#POP
	addu  $sp, $sp, 4
	beqz  $a0, ._L0
	lw    $a0, _x
	sw $a0, 0($sp)		#PUSH
	subu  $sp, $sp, 4
	lw $a0, 0($sp)		#POP
	addu  $sp, $sp, 4
	la    $a0, .newline
	li    $v0, 4
	syscall
	lw    $a0, _x
	sw $a0, 0($sp)		#PUSH
	subu  $sp, $sp, 4
	lw    $a0, _x
	sw $a0, 0($sp)		#PUSH
	subu  $sp, $sp, 4
	lw $t1, 0($sp)		#POP
	addu  $sp, $sp, 4
	lw $t0, 0($sp)		#POP
	addu  $sp, $sp, 4
	add   $a0, $t0, $t1
	sw $a0, 0($sp)		#PUSH
	subu  $sp, $sp, 4
	jal   _recursive
	b     ._L0
._L0: 
._L0: 
_recursive_exit: 
		# Method Epilogue
	move  $sp, $fp
	lw $ra, 0($fp)
	lw $fp, -4($fp)
	jr    $ra
.text
